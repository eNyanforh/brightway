enum ManagementCaseKind {
  SUPPORT
  REPORT
}
enum ManagementCaseStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_USER
  RESOLVED
  DISMISSED
}
enum ManagementCasePriority {
  NORMAL
  HIGH
  URGENT
}
model ManagementCase {
  id String @id @default(uuid())
  kind ManagementCaseKind
  subject String @db.VarChar(160)
  status ManagementCaseStatus @default(OPEN)
  priority ManagementCasePriority @default(NORMAL)
  version Int @default(1)
  creatorKey String
  idempotencyKey String @db.VarChar(36)
  requestHash String @db.VarChar(64)
  creatorAccountId String?
  creatorAccount Account? @relation(fields: [creatorAccountId], references: [id], onDelete: Restrict)
  createdByStaffId String?
  createdByStaff ManagementStaff? @relation("CaseCreatedBy", fields: [createdByStaffId], references: [id], onDelete: Restrict)
  assignedStaffId String?
  assignedStaff ManagementStaff? @relation("CaseAssignedTo", fields: [assignedStaffId], references: [id], onDelete: Restrict)
  targetType String? @db.VarChar(30)
  targetId String?
  closedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages ManagementCaseMessage[]
  @@unique([creatorKey, idempotencyKey])
  @@index([kind, status, createdAt, id])
  @@index([creatorAccountId, createdAt, id])
  @@index([assignedStaffId, status])
}
model ManagementCaseMessage {
  id String @id @default(uuid())
