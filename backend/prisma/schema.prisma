generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model SystemRecord {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model Person {
  identityRevision Int @default(0)
  id          String    @id @default(uuid())
  firstName   String
  middleName  String?
  lastName    String
  birthDate   DateTime? @db.Date
  gender      PersonGender?
  phoneNumber String?

  account Account?
  profile Profile?
  photos  PhotoAsset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PersonGender {
  FEMALE
  MALE
  OTHER
  PREFER_NOT_TO_SAY
}

model Account {
  organizationOperator OrganizationOperator?
  organizationRoleAudits OrganizationOperatorAudit[]
  organizationRequests OrganizationRequest[] @relation("OrganizationApplicant")
  assignedOrganizationRequests OrganizationRequest[] @relation("OrganizationAgent")
  decidedOrganizationRequests OrganizationRequest[] @relation("OrganizationApprover")
  organizationMemberships OrganizationMembership[]
  receivedOrganizationInvitations OrganizationInvitation[] @relation("OrganizationInviteRecipient")
  sentOrganizationInvitations OrganizationInvitation[] @relation("OrganizationInviteSender")
  organizationStaffActions OrganizationStaffAudit[]
  organizationFindings OrganizationFinding[]
  retiredOrganizationFindings OrganizationFindingArchive[] @relation("ArchivedOrganizationAgent")
  organizationReassignments OrganizationFindingArchive[] @relation("OrganizationFindingRetiredBy")

  latestNameChangeId String? @unique
  latestNameChangeProof IdentityNameChange? @relation("LatestNameChange", fields: [latestNameChangeId], references: [id], onDelete: Restrict)
  nameChanges IdentityNameChange[] @relation("NameChangeOwner")
  assignedNameChanges IdentityNameChange[] @relation("NameChangeReviewer")
  photoReviewRequired Boolean @default(false)
  photoReviews ProfilePhotoReview[] @relation("PhotoReviewOwner")
  assignedPhotoReviews ProfilePhotoReview[] @relation("PhotoReviewAssignee")
  identityRevision Int @default(0)
  id           String        @id @default(uuid())
  username     String        @unique
  email        String        @unique
  passwordHash String
  status       AccountStatus @default(ACTIVE)

  platformRole PlatformRole @default(MEMBER)

  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?

  personId String @unique
  person   Person @relation(fields: [personId], references: [id], onDelete: Restrict)

  manualIdentityRequest ManualIdentityRequest?
  manualIdentityReviewer ManualIdentityReviewer?
  manualIdentityEvidence ManualIdentityEvidence[]
  manualIdentityUploadBudget ManualIdentityUploadBudget?

  identityVerification IdentityVerification?

  sessions       Session[]
  emailChallenge AccountEmailChallenge?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model Session {
  mfaVersion Int @default(0)
  mfaVerifiedAt DateTime?
  id        String   @id @default(uuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, expiresAt])
  @@index([expiresAt])
}

// Owner-only draft data. No verification or publishing state is client editable.
model Profile {
  latestPhotoReviewId String? @unique
  latestPhotoReview ProfilePhotoReview? @relation("LatestPhotoReview", fields: [latestPhotoReviewId], references: [id], onDelete: Restrict)
  photoReviews ProfilePhotoReview[] @relation("ProfilePhotoReviewHistory")
  identityRevision Int @default(0)
  id                 String             @id @default(uuid())
  personId           String             @unique
  person             Person             @relation(fields: [personId], references: [id], onDelete: Restrict)
  version            Int                @default(0)
  educationMode      ProfileHistoryMode @default(UNSET)
  experienceMode     ProfileHistoryMode @default(UNSET)
  credentialReviews  CredentialReview[]
  educationRecords   EducationRecord[]
  experienceRecords  ExperienceRecord[]
  countryCode        String?            @db.VarChar(2)
  region             String?            @db.VarChar(100)
  locality           String?            @db.VarChar(100)
  headline           String?            @db.VarChar(120)
  bio                String?            @db.VarChar(2000)
  careerFieldMode    CareerFieldMode?
  careerField        String?            @db.VarChar(100)
  careerGoals        String?            @db.VarChar(1000)
  skills             String[]           @default([])
  interests          String[]           @default([])
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  photoId            String?            @unique
  photo              PhotoAsset?        @relation(fields: [photoId], references: [id], onDelete: Restrict)
  whatsappNumber     String?            @db.VarChar(16)
  emailVisibility    ContactVisibility  @default(ONLY_ME)
  phoneVisibility    ContactVisibility  @default(ONLY_ME)
  whatsappVisibility ContactVisibility  @default(ONLY_ME)
}

enum CareerFieldMode {
  EXPLORING
  SPECIFIED
}

model SignupDraft {
  id                 String       @id @default(uuid())
  tokenHash          String       @unique
  expiresAt          DateTime
  createdAt          DateTime     @default(now())
  uploadCount        Int          @default(0)
  email              String?      @db.VarChar(254)
  emailCodeHash      String?      @db.VarChar(64)
  emailCodeExpiresAt DateTime?
  emailCodeAttempts  Int          @default(0)
  emailSendCount     Int          @default(0)
  emailSentAt        DateTime?
  emailVerifiedAt    DateTime?
  emailVerifiedUntil DateTime?
  photos             PhotoAsset[]

  @@index([expiresAt])
}

model PhotoAsset {
  proposedReview ProfilePhotoReview? @relation("ProposedPhoto")
  previousReviews ProfilePhotoReview[] @relation("PreviousPhoto")
  id         String       @id @default(uuid())
  storageKey String       @unique
  state      PhotoState   @default(UPLOADING)
  expiresAt  DateTime
  byteSize   Int?
  width      Int?
  height     Int?
  draftId    String?
  draft      SignupDraft? @relation(fields: [draftId], references: [id], onDelete: Restrict)
  personId   String?
  person     Person?      @relation(fields: [personId], references: [id], onDelete: Restrict)
  currentFor Profile?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([state, expiresAt])
  @@index([personId])
  @@index([draftId])
}

enum PhotoState {
  UPLOADING
  READY
  CLAIMED
  DELETE_PENDING
  DELETED
}

enum ProfileHistoryMode {
  UNSET
  NONE
  RECORDS
}

enum CredentialStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  VERIFIED
  ACTION_REQUIRED
  UNABLE_TO_VERIFY
  FALSE_CREDENTIAL
}

enum ExperienceType {
  EMPLOYMENT
  INTERNSHIP
  VOLUNTEERING
  SELF_EMPLOYMENT
}

model EducationRecord {
  id            String           @id @default(uuid())
  profileId     String
  profile       Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  revision      Int              @default(1)
  status        CredentialStatus @default(DRAFT)
  institution   String           @db.VarChar(160)
  qualification String           @db.VarChar(160)
  startMonth    String           @db.VarChar(7)
  endMonth      String?          @db.VarChar(7)
  current       Boolean
  description   String           @db.VarChar(1000)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([profileId, createdAt])
}

model ExperienceRecord {
  id           String           @id @default(uuid())
  profileId    String
  profile      Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  revision     Int              @default(1)
  status       CredentialStatus @default(DRAFT)
  organization String           @db.VarChar(160)
  role         String           @db.VarChar(160)
  type         ExperienceType
  startMonth   String           @db.VarChar(7)
  endMonth     String?          @db.VarChar(7)
  current      Boolean
  description  String           @db.VarChar(1000)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([profileId, createdAt])
}

enum ContactVisibility {
  ONLY_ME
  CONNECTIONS
  PUBLIC
}

// Hashed recipient/hour buckets limit deliveries across browsers and server restarts.
model SignupEmailDeliveryLimit {
  id        String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

// Existing accounts prove ownership without changing their address or login access.
model AccountEmailChallenge {
  accountId String   @id
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  email     String   @db.VarChar(254)
  nonce     String
  codeHash  String?  @db.VarChar(64)
  expiresAt DateTime
  sentAt    DateTime
  attempts  Int      @default(0)
}


enum PlatformRole {
  MEMBER
  CREDENTIAL_REVIEWER
}

enum CredentialKind {
  education
  experience
}

enum EvidenceState {
  UPLOADING
  READY
  ATTACHED
  DELETE_PENDING
  DELETED
}

model CredentialReview {
  id                 String @id @default(uuid())
  profileId          String
  profile            Profile @relation(fields: [profileId], references: [id], onDelete: Restrict)
  kind               CredentialKind
  recordId           String
  revision           Int
  version            Int @default(1)
  status             CredentialStatus @default(SUBMITTED)
  initialSubmittedAt DateTime @default(now())
  submittedAt        DateTime @default(now())
  reviewerId         String?
  note               String? @db.VarChar(2000)
  issuerOrganizationId String?
  issuerOrganization Organization? @relation("CredentialIssuer", fields: [issuerOrganizationId], references: [id], onDelete: Restrict)
  issuerName String? @db.VarChar(160)
  attempts           CredentialAttempt[]
  events             CredentialAuditEvent[]
  @@unique([kind, recordId])
  @@index([issuerOrganizationId, kind, initialSubmittedAt, id], map: "CredentialReview_issuer_kind_submitted_id_idx")
  @@index([status, initialSubmittedAt, id])
}

model CredentialAttempt {
  id         String @id @default(uuid())
  reviewId   String
  review     CredentialReview @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  revision   Int
  snapshot   Json
  issuerOrganizationId String?
  issuerOrganization Organization? @relation("CredentialAttemptIssuer", fields: [issuerOrganizationId], references: [id], onDelete: Restrict)
  issuerName String? @db.VarChar(160)
  status     CredentialStatus @default(SUBMITTED)
  reviewerId String?
  note       String? @db.VarChar(2000)
  createdAt  DateTime @default(now())
  decidedAt  DateTime?
  evidence   CredentialEvidence[]
  @@index([reviewId, createdAt, id])
}

model CredentialEvidence {
  id          String @id @default(uuid())
  personId    String
  kind        CredentialKind
  recordId    String
  revision    Int
  state       EvidenceState @default(UPLOADING)
  storageKey  String @unique
  contentType String
  size        Int @default(0)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  attemptId   String?
  attempt     CredentialAttempt? @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  @@index([personId, recordId, revision, state])
  @@index([state, expiresAt])
}

model CredentialUploadBudget {
  personId String
  hour     DateTime
  count    Int @default(0)
  @@id([personId, hour])
}

model CredentialAuditEvent {
  id         String @id @default(uuid())
  reviewId   String
  review     CredentialReview @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  actorId    String
  action     String
  revision   Int
  fromStatus CredentialStatus
  toStatus   CredentialStatus
  note       String? @db.VarChar(2000)
  createdAt  DateTime @default(now())
  @@index([reviewId, createdAt, id])
}

model ReviewerRoleAudit {
  id              String @id @default(uuid())
  targetAccountId String
  actor           String @default("SERVER_OPERATOR_CLI")
  fromRole        PlatformRole
  toRole          PlatformRole
  createdAt       DateTime @default(now())
}

// Reset challenges are separate from signup/email-verification proofs.
model PasswordResetChallenge {
  emailKey            String   @id
  nonce               String   @unique @default(uuid())
  accountId           String?
  passwordFingerprint String?
  codeHash            String
  expiresAt           DateTime
  ready               Boolean  @default(false)
  attempts            Int      @default(0)
  consumedAt          DateTime?
  requestWindowStart  DateTime
  requestCount        Int      @default(1)
  lastRequestedAt     DateTime
  @@index([accountId])
  @@index([lastRequestedAt])
}

model PasswordRecoveryAudit {
  id        String   @id @default(uuid())
  accountId String
  action    String
  createdAt DateTime @default(now())
  @@index([accountId, createdAt])
}

model MfaFactor {
  accountId String @id
  encryptedSecret String
  enabled Boolean @default(false)
  version Int @default(0)
  lastCounter BigInt @default(-1)
  setupExpiresAt DateTime?
  recoveryHashes String[] @default([])
  failureCount Int @default(0)
  windowStart DateTime
}
model MfaLoginChallenge {
  tokenHash String @id
  accountId String
  passwordFingerprint String
  factorVersion Int
  expiresAt DateTime
  consumedAt DateTime?
  attempts Int @default(0)
  @@index([accountId])
  @@index([expiresAt])
}
model MfaAudit {
  id String @id @default(uuid())
  accountId String
  action String
  method String?
  createdAt DateTime @default(now())
  @@index([accountId, createdAt])
}

// Sandbox-only Persona integration. Never use these results as a production trust flag.
model IdentityVerification {
  accountId String @id
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  currentAttemptId String?
  windowStart DateTime
  startCount Int @default(0)
  inquiries IdentityInquiry[]
}
model IdentityInquiry {
  id String @id @default(uuid())
  accountId String
  verification IdentityVerification @relation(fields: [accountId], references: [accountId], onDelete: Cascade)
  environment String @default("sandbox")
  templateId String
  referenceId String @unique
  idempotencyKey String @unique
  identityHash String @db.VarChar(64)
  inquiryId String? @unique
  providerStatus String @default("creating")
  providerUpdatedAt DateTime?
  checkedAt DateTime?
  createRetryUntil DateTime
  createdAt DateTime @default(now())
  @@index([accountId, createdAt])
}
model IdentityWebhookReceipt {
  id String @id
  inquiryId String
  outcome String
  createdAt DateTime @default(now())
  @@index([createdAt])
}

// Durable minimal events. DONE/FAILED job payloads contain no raw Persona PII or access URLs.
model IdentityWebhookJob {
  id String @id
  eventName String
  payload Json
  state String @default("PENDING")
  attempts Int @default(0)
  availableAt DateTime @default(now())
  leaseToken String?
  leaseUntil DateTime?
  lastFailure String?
  createdAt DateTime @default(now())
  processedAt DateTime?
  @@index([state, availableAt])
  @@index([state, leaseUntil])
}

// Private, unsubmitted identity evidence. Never a public profile photo or credential attachment.
enum ManualIdentityEvidenceKind {
  GOVERNMENT_ID
  SELFIE
}
model ManualIdentityEvidence {
  nameChangeId String?
  nameChange IdentityNameChange? @relation(fields: [nameChangeId], references: [id], onDelete: Restrict)
  attemptId String?
  attempt ManualIdentityAttempt? @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  id String @id @default(uuid())
  accountId String
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  kind ManualIdentityEvidenceKind
  state EvidenceState @default(UPLOADING)
  storageKey String @unique
  size Int @default(0)
  width Int?
  height Int?
  consentVersion String
  consentedAt DateTime
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([attemptId, state])
  @@index([nameChangeId, state])
  @@index([accountId, state, expiresAt])
  @@index([state, expiresAt])
}
model ManualIdentityUploadBudget {
  accountId String @id
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  windowStart DateTime
  count Int @default(0)
}

// Independent of school/employer credential review and paused Persona sandbox state.
enum ManualIdentityStatus {
  SUBMITTED
  IN_REVIEW
  APPROVED
  DECLINED
  ACTION_REQUIRED
  INVALIDATED
  EXPIRED
}
model ManualIdentityRequest {
  id String @id @default(uuid())
  accountId String @unique
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  version Int @default(1)
  revision Int @default(1)
  state ManualIdentityStatus @default(SUBMITTED)
  currentAttemptId String
  initialSubmittedAt DateTime
  targetAt DateTime
  calendarVersion String
  windowStart DateTime
  submissionCount Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  attempts ManualIdentityAttempt[]
  events ManualIdentityAudit[]
  @@index([state, initialSubmittedAt, id])
}
model ManualIdentityAttempt {
  nameChanges IdentityNameChange[]
  photoReviews ProfilePhotoReview[]
  id String @id @default(uuid())
  requestId String
  request ManualIdentityRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  revision Int
  state ManualIdentityStatus @default(SUBMITTED)
  idempotencyKey String
  inputHash String
  identityHash String
  profileVersion Int
  snapshot Json?
  educationRecordId String
  educationRevision Int
  experienceRecordId String
  experienceRevision Int
  reviewerId String?
  note String? @db.VarChar(2000)
  consentVersion String
  consentedAt DateTime
  submittedAt DateTime
  expiresAt DateTime
  purgeAt DateTime
  retentionDays Int
  targetAt DateTime
  calendarVersion String
  decidedAt DateTime?
  purgedAt DateTime?
  evidence ManualIdentityEvidence[]
  @@unique([requestId, idempotencyKey])
  @@unique([requestId, revision])
  @@index([purgeAt, purgedAt])
}
model ManualIdentityReviewer {
  accountId String @id
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  enabled Boolean @default(false)
  updatedAt DateTime @updatedAt
}
model ManualIdentityAudit {
  id String @id @default(uuid())
  requestId String?
  request ManualIdentityRequest? @relation(fields: [requestId], references: [id], onDelete: Restrict)
  targetAccountId String
  actorId String
  action String
  attemptId String?
  fromState ManualIdentityStatus?
  toState ManualIdentityStatus?
  note String? @db.VarChar(2000)
  createdAt DateTime @default(now())
  @@index([requestId, createdAt, id])
  @@index([targetAccountId, createdAt])
}

// Replacements after identity approval are private until a separately audited decision.
enum ProfilePhotoReviewState {
  PENDING
  IN_REVIEW
  APPROVED
  DECLINED
  SUPERSEDED
  CANCELLED
}
model ProfilePhotoReview {
  id String @id @default(uuid())
  accountId String
  account Account @relation("PhotoReviewOwner", fields: [accountId], references: [id], onDelete: Restrict)
  profileId String
  profile Profile @relation("ProfilePhotoReviewHistory", fields: [profileId], references: [id], onDelete: Restrict)
  latestFor Profile? @relation("LatestPhotoReview")
  candidatePhotoId String @unique
  candidatePhoto PhotoAsset @relation("ProposedPhoto", fields: [candidatePhotoId], references: [id], onDelete: Restrict)
  previousPhotoId String?
  previousPhoto PhotoAsset? @relation("PreviousPhoto", fields: [previousPhotoId], references: [id], onDelete: Restrict)
  identityAttemptId String?
  identityAttempt ManualIdentityAttempt? @relation(fields: [identityAttemptId], references: [id], onDelete: Restrict)
  baseIdentityHash String
  approvedIdentityHash String?
  state ProfilePhotoReviewState @default(PENDING)
  version Int @default(1)
  reviewerId String?
  reviewer Account? @relation("PhotoReviewAssignee", fields: [reviewerId], references: [id], onDelete: Restrict)
  note String? @db.VarChar(2000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  decidedAt DateTime?
  events ProfilePhotoReviewAudit[]
  @@index([accountId, createdAt, id])
  @@index([state, createdAt, id])
}
model ProfilePhotoReviewAudit {
  id String @id @default(uuid())
  reviewId String
  review ProfilePhotoReview @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  actorId String
  action String
  fromState ProfilePhotoReviewState?
  toState ProfilePhotoReviewState
  note String? @db.VarChar(2000)
  createdAt DateTime @default(now())
  @@index([reviewId, createdAt, id])
}

enum IdentityNameChangeState {
  SUBMITTED
  IN_REVIEW
  APPROVED
  DECLINED
  CANCELLED
  EXPIRED
}

model IdentityNameChange {
  id String @id @default(uuid())
  accountId String
  account Account @relation("NameChangeOwner", fields: [accountId], references: [id], onDelete: Restrict)
  latestFor Account? @relation("LatestNameChange")
  identityAttemptId String
  identityAttempt ManualIdentityAttempt @relation(fields: [identityAttemptId], references: [id], onDelete: Restrict)
  idempotencyKey String
  inputHash String
  baseIdentityHash String
  approvedIdentityHash String?
  previousName Json?
  proposedName Json?
  reason String? @db.VarChar(1000)
  state IdentityNameChangeState @default(SUBMITTED)
  version Int @default(1)
  reviewerId String?
  reviewer Account? @relation("NameChangeReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  note String? @db.VarChar(2000)
  consentVersion String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  targetAt DateTime
  calendarVersion String
  expiresAt DateTime
  purgeAt DateTime
  decidedAt DateTime?
  purgedAt DateTime?
  evidence ManualIdentityEvidence[]
  events IdentityNameChangeAudit[]
  @@unique([accountId, idempotencyKey])
  @@index([state, createdAt, id])
  @@index([accountId, createdAt, id])
  @@index([purgeAt, purgedAt])
}

model IdentityNameChangeAudit {
  id String @id @default(uuid())
  requestId String
  request IdentityNameChange @relation(fields: [requestId], references: [id], onDelete: Restrict)
  actorId String
  action String
  fromState IdentityNameChangeState?
  toState IdentityNameChangeState
  createdAt DateTime @default(now())
  @@index([requestId, createdAt, id])
}

// Sprint 2: global presence is independent of Campus activation and credential-review powers.
enum OrganizationType {
  SCHOOL
  NGO
  COMPANY
}
enum OrganizationRequestStatus {
  SUBMITTED
  ASSIGNED
  RECOMMENDED
  APPROVED
  REJECTED
}
enum OrganizationRecommendation {
  APPROVE
  REJECT
}
enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}
enum OrganizationMembershipRole {
  PRIMARY_ADMIN
  STAFF
}
model OrganizationOperator {
  accountId String @id
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  agentEnabled Boolean @default(false)
  approverEnabled Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model OrganizationOperatorAudit {
  id String @id @default(uuid())
  targetAccountId String
  target Account @relation(fields: [targetAccountId], references: [id], onDelete: Restrict)
  actorId String
  capability String @db.VarChar(30)
  enabled Boolean
  createdAt DateTime @default(now())
  @@index([targetAccountId, createdAt])
}
model OrganizationRequest {
  id String @id @default(uuid())
  applicantId String
  applicant Account @relation("OrganizationApplicant", fields: [applicantId], references: [id], onDelete: Restrict)
  idempotencyKey String
  inputHash String @db.VarChar(64)
  fingerprint String @db.VarChar(64)
  name String @db.VarChar(160)
  type OrganizationType
  representativeRole String @db.VarChar(120)
  countryCode String @db.VarChar(2)
  region String @db.VarChar(120)
  city String @db.VarChar(120)
  address String @db.VarChar(300)
  offersTraining Boolean
  status OrganizationRequestStatus @default(SUBMITTED)
  version Int @default(1)
  assignedAgentId String?
  assignedAgent Account? @relation("OrganizationAgent", fields: [assignedAgentId], references: [id], onDelete: Restrict)
  decidedById String?
  decidedBy Account? @relation("OrganizationApprover", fields: [decidedById], references: [id], onDelete: Restrict)
  decisionReason String? @db.VarChar(2000)
  decidedAt DateTime?
  targetAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  finding OrganizationFinding?
  findingHistory OrganizationFindingArchive[]
  organization Organization?
  audits OrganizationRequestAudit[]
  @@unique([applicantId, idempotencyKey])
  @@index([applicantId, createdAt, id])
  @@index([status, createdAt, id])
  @@index([assignedAgentId, status, createdAt])
}
model OrganizationFinding {
  requestId String @id
  request OrganizationRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  agentId String
  agent Account @relation(fields: [agentId], references: [id], onDelete: Restrict)
  existenceConfirmed Boolean
  locationConfirmed Boolean
  authorityConfirmed Boolean
  typeConfirmed Boolean
  operationalConfirmed Boolean
  recommendation OrganizationRecommendation
  notes String @db.VarChar(4000)
  setupAssistance String @db.VarChar(2000)
  createdAt DateTime @default(now())
}
model OrganizationFindingArchive {
  id String @id @default(uuid())
  requestId String
  request OrganizationRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  agentId String
  agent Account @relation("ArchivedOrganizationAgent", fields: [agentId], references: [id], onDelete: Restrict)
  sourceVersion Int
  existenceConfirmed Boolean
  locationConfirmed Boolean
  authorityConfirmed Boolean
  typeConfirmed Boolean
  operationalConfirmed Boolean
  recommendation OrganizationRecommendation
  notes String @db.VarChar(4000)
  setupAssistance String @db.VarChar(2000)
  createdAt DateTime
  retiredAt DateTime @default(now())
  retiredById String
  retiredBy Account @relation("OrganizationFindingRetiredBy", fields: [retiredById], references: [id], onDelete: Restrict)
  @@unique([requestId, sourceVersion])
