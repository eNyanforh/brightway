enum MemberPostType {
  POST
  ACHIEVEMENT
  EVENT
  QUESTION
}

enum MemberPostModerationStatus {
  PENDING
  PUBLISHED
  REJECTED
}

enum MemberPostScreenStatus {
  NOT_CONFIGURED
  CLEAR
  FLAGGED
  UNAVAILABLE
}

enum MemberPostRelevanceStatus {
  NOT_CONFIGURED
  RELEVANT
  UNCERTAIN
  OFF_TOPIC
  UNAVAILABLE
}

model MemberPost {
  views PostView[]
  reports PostReport[]
  registrations EventRegistration[]
  answers QuestionAnswer[]
  reposts PostRepost[]
  saves PostSave[]
  comments PostComment[]
  likes PostLike[]
  id String @id @default(uuid())
  authorId String
  author Account @relation(fields: [authorId], references: [id], onDelete: Restrict)
  requestKey String
  type MemberPostType @default(POST)
  tags String[] @default([])
  eventDetails Json?
  questionDetails Json?
  body String @db.VarChar(2000)
  moderationStatus MemberPostModerationStatus @default(PENDING)
  moderationVersion Int @default(1)
