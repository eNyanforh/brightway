 intake TvetIntake @relation(fields:[campusId,programId,intakeId],references:[campusId,programId,id],onDelete:Restrict)
 sectionId String?
 section TvetSection? @relation(fields:[campusId,intakeId,sectionId],references:[campusId,intakeId,id],onDelete:Restrict)
