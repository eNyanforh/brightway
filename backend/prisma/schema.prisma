  withdrawnAt DateTime?
  @@unique([authorId, requestKey])
  @@index([withdrawnAt, createdAt, id])
  @@index([moderationStatus, withdrawnAt, createdAt, id])
  @@index([authorId, withdrawnAt, createdAt, id])
  @@index([authorId, createdAt])
}

// Legacy registrations are approved on migration; new requests can require host approval.
