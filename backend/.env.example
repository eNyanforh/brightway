# Template only. Copy your EXISTING private backend/.env into this project locally.
# Preserve your original MFA_ENCRYPTION_KEY for already-enrolled authenticators.
NODE_ENV="development"
PORT=5000
CLIENT_URL="http://localhost:5173"

# Application database: runtime connection and direct migration connection.
DATABASE_URL=""
DIRECT_URL=""

# A DIFFERENT database or Neon branch; use its direct, unpooled connection.
TEST_DATABASE_URL=""

# Server-only email settings. Use your existing valid sender and credentials.
RESEND_API_KEY=""
EMAIL_FROM="BrightWay <no-reply@example.com>"
EMAIL_VERIFICATION_SECRET=""

# Existing 64-hex-character key; generate locally only if never configured.
MFA_ENCRYPTION_KEY=""

# Private Cloudflare R2 storage.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_JURISDICTION="default"
AUTH_TIMING="false"
