# COPY to deploy/staging/.env.staging only on the private host; never commit filled values.
NODE_ENV=production
BRIGHTWAY_STAGE=private-staging
STAGING_DATABASE_ACK=isolated-staging-database
CLIENT_URL=https://localhost:8443
# A DEDICATED staging database/branch; not development, test or eventual live production.
DATABASE_URL=
DIRECT_URL=
# Preserve the staging key across deployments. Use a new staging key when using fresh accounts.
MFA_ENCRYPTION_KEY=
EMAIL_VERIFICATION_SECRET=
RESEND_API_KEY=
EMAIL_FROM="BrightWay Staging <hello@joinbrightway.me>"
# Separate private STAGING buckets and credentials limited to those buckets.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_IDENTITY_BUCKET=
R2_JURISDICTION=default
MANUAL_IDENTITY_RETENTION_DAYS=30
MANUAL_IDENTITY_HOLIDAYS=
AUTH_TIMING=false
# Do not include Persona settings: the integration is paused.
